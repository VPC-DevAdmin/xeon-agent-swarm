# Top-level dependency INTENT for the tier-router / deepagents build.
#
# deepagents 0.6.10 constrains the LangChain/LangGraph stack. Do NOT hand-pin the
# transitive langchain-* versions from memory — install this file, then freeze:
#
#   pip install -r backend/requirements.in
#   pip freeze > backend/requirements.txt
#
# (deepagents_integration_reference.md, "Versions and install".)

# ── deepagents core (tier-router migration) ──────────────────────────────────
deepagents==0.6.10
langchain-openai             # ChatOpenAI pointed at the gateway (inference/model.py)
langgraph-checkpoint-sqlite  # AsyncSqliteSaver (live agent state + resume)
langchain-mcp-adapters       # turn the MCP toolbox servers into LangChain tools
# deepagents[quickjs]        # uncomment only for the sandboxed eval tool

