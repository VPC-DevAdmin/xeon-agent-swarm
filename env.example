# ── LLM router ────────────────────────────────────────────────────────────────
# This project serves no LLMs. All inference goes to the external LLM router.
# Contract: see docs/router-contract.md (OpenAI Chat Completions, three
# router-specific response headers, W3C traceparent propagation).
LLM_TIER_ENDPOINT=https://router.internal/v1
LLM_TIER_TOKEN=

# Per-role specialty model names. The router resolves each to a concrete model
# with strict pinning. See docs/router-contract.md §2.
ORCHESTRATOR_MODEL=orchestrator-v2.1
VALIDATOR_MODEL=validator-v1.0
WORKER_DEFAULT_MODEL=worker-default-v1.0
REDUCER_MODEL=worker-default-v1.0

# Optional separate vision endpoint. Leave VLM_ENDPOINT blank to route vision
# work through the main router using a vision-capable specialty.
VLM_ENDPOINT=
VLM_MODEL=worker-vision-v1.0

# ── Legacy endpoint env vars (kept for backward compatibility) ─────────────────
# If LLM_TIER_ENDPOINT is unset, the code falls back to these. Remove once all
# environments are migrated.
# TEXT_ENGINE_ENDPOINT=http://localhost:8080/v1
# TEXT_ENGINE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# ORCHESTRATOR_ENDPOINT=http://localhost:8080/v1

# ── Client-side rate limiting ────────────────────────────────────────────────
# Caps concurrent in-flight requests to the router from this backend. Validator
# fanout is high; tune up if the router has headroom, down if you see 429s.
WORKER_CONCURRENCY=8
INFERENCE_MAX_RETRIES=3

# ── Semantic search (knowledge retrieval) ────────────────────────────────────
# The sibling search project. mcp-doc-retrieval is a thin MCP proxy to this
# endpoint. See mcp_servers/doc_retrieval/server.py for the request shape.
SEMANTIC_SEARCH_ENDPOINT=https://search.internal
SEMANTIC_SEARCH_TOKEN=
SEMANTIC_SEARCH_TIMEOUT=20

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used by backend.queue.task_queue for run-result cache and pubsub. No corpus
# or vector index is stored here anymore — that lives in the search project.
REDIS_URL=redis://localhost:6479

# ── MCP servers ───────────────────────────────────────────────────────────────
MCP_WEB_SEARCH_URL=http://localhost:9401
MCP_DOC_RETRIEVAL_URL=http://localhost:9402
MCP_CODE_EXEC_URL=http://localhost:9403

# ── Brave Search API key (optional; MCP web_search falls back to DuckDuckGo) ─
BRAVE_API_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
